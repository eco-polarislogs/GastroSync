# ─────────────────────────────────────────────────────────────
# GastroSync ortam değişkenleri — bu dosyayı .env olarak kopyalayıp doldurun.
# .env dosyası git'e GİRMEZ. Gerçek şifreleri asla depoya eklemeyin.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=gastrosync
POSTGRES_USER=gastrosync
POSTGRES_PASSWORD=degistirin-guclu-bir-sifre

# Yerel geliştirme (backend'i Docker dışında çalıştırırken)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gastrosync
DB_USERNAME=gastrosync
DB_PASSWORD=degistirin-guclu-bir-sifre

# JWT imzalama anahtarı (en az 32 bayt). Üretmek için:
#   openssl rand -base64 48
GASTROSYNC_JWT_SECRET=
# Erişim token'ı süresi (ms) — 15 dk; oturum dönen yenileme token'ı ile sürer
GASTROSYNC_JWT_EXPIRATION=900000
# Yenileme token'ı (gün, kullanılmazsa) ve mutlak oturum süresi (gün)
GASTROSYNC_REFRESH_EXPIRATION_DAYS=7
GASTROSYNC_SESSION_MAX_DAYS=30

# Telefon bildirimleri (Expo Push). Expo panelinde "Enhanced push security" açıksa erişim token'ı
GASTROSYNC_EXPO_ACCESS_TOKEN=

# Günlük veritabanı yedeklerinin saklanma süresi (gün) ve HTTPS alan adı (docker compose --profile tls)
BACKUP_KEEP_DAYS=14
DOMAIN=panel.restoraniniz.com

# İlk kurulum: veritabanı boşken oluşturulacak 'admin' hesabının geçici şifresi
# (en az 8 karakter, harf + rakam). İlk girişte değiştirilmesi zorunludur.
GASTROSYNC_ADMIN_PASSWORD=

# Demo verisi (yalnızca geliştirme / tanıtım). Canlıda false.
GASTROSYNC_SEED_DEMO_DATA=false

# Web arayüzünün yayınlandığı adres(ler), virgülle ayrılmış (örn. https://panel.restoraniniz.com)
CORS_ALLOWED_ORIGINS=http://localhost

# Swagger UI (canlıda kapalı tutun)
SWAGGER_ENABLED=false

# Web sunucusunun dinleyeceği port
HTTP_PORT=80

# İşletme kimliği (fiş başlığı, e-Arşiv satıcı bilgisi)
GASTROSYNC_RESTAURANT_NAME=Restoran Adı
GASTROSYNC_RECEIPT_FOOTER=Afiyet olsun!
GASTROSYNC_COMPANY_TITLE=Unvan Ltd. Şti.
GASTROSYNC_COMPANY_VKN=0000000000
GASTROSYNC_COMPANY_TAX_OFFICE=Vergi Dairesi
GASTROSYNC_COMPANY_ADDRESS=Adres
GASTROSYNC_COMPANY_CITY=İl
# Mali belge sağlayıcısı: NONE (XML taslak) | TEST
GASTROSYNC_FISCAL_PROVIDER=NONE
GASTROSYNC_EARSIV_PREFIX=GSA
