{
  "expo": {
    "name": "GastroSync",
    "slug": "gastrosync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "GastroSync depo mal kabul ve barkod okuma işlemleri için kamera izni gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "GastroSync mal kabul ve stok takibi için kamera izni gereklidir."
        }
      ],
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
